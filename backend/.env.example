# Backend environment variables — copy this file to `.env` for local development.
# On Render, set these in the dashboard (or via render.yaml envVars).

# Port the HTTP + WebSocket server listens on. Render sets PORT automatically.
PORT=4000

# Comma-separated list of allowed browser origins for REST/GraphQL/RPC + Socket.io.
# Use the exact Vercel frontend URL in production (e.g. https://order-tracker.vercel.app).
# Use "*" during local development to allow any origin.
ALLOWED_ORIGINS=*

# Node environment.
NODE_ENV=development
